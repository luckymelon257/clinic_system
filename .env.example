# Postgres (docker compose maps container 5432 -> host 5434)
DATABASE_URL=postgres://clinic:clinic@localhost:5434/clinic
# API
PORT=4000
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=8h
# Web
VITE_API_URL=http://localhost:4000
VITE_USE_MOCKS=0
# Lab 2: Neo4j (bolt on host port 7688; neo4j-test profile → 7689) and Redis (host port 6380)
NEO4J_URL=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=clinicneo4j
REDIS_URL=redis://localhost:6380/0
REDIS_PREFIX=clinic
