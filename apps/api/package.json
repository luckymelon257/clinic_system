{
  "name": "@clinic/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src tests scripts vitest.config.ts tsup.config.ts",
    "check:sql-access": "tsx scripts/check-sql-access.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@clinic/contracts": "workspace:*",
    "@clinic/graph": "workspace:*",
    "@clinic/redis": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "neo4j-driver": "5.28.3",
    "pg": "^8.23.1",
    "redis": "5.12.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clinic/db": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
