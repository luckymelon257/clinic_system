{
  "name": "clinic-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @clinic/db migrate",
    "db:seed": "pnpm --filter @clinic/db seed",
    "db:reset": "pnpm --filter @clinic/db reset",
    "e2e": "pnpm --filter @clinic/e2e e2e",
    "nosql:up": "docker compose up -d --wait db neo4j redis",
    "graph:sync": "pnpm --filter @clinic/graph sync",
    "bench": "pnpm --filter @clinic/bench bench",
    "bench:report": "pnpm --filter @clinic/bench report",
    "simulate": "pnpm --filter @clinic/redis simulate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.0",
    "turbo": "^2.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
